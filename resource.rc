1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Keytech Project"
            VALUE "FileDescription", "KEYTECH - Dual Virtual Gamepad Hub & In-Game Overlay"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "InternalName", "keytech"
            VALUE "LegalCopyright", "Copyright (c) 2026 tohfa"
            VALUE "OriginalFilename", "keytech.exe"
            VALUE "ProductName", "KEYTECH"
            VALUE "ProductVersion", "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
